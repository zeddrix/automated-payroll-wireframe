{
  "name": "automated-payroll-wireframe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C wireframe dev",
    "build": "pnpm -C wireframe build",
    "sync": "pnpm -C wireframe sync",
    "check": "pnpm sync && pnpm exec svelte-check --tsconfig wireframe/tsconfig.json",
    "quality:types-and-lint": "pnpm sync && concurrently -n check,lint -c blue,green \"pnpm exec svelte-check --tsconfig wireframe/tsconfig.json\" \"pnpm lint\"",
    "quality": "pnpm format && pnpm quality:types-and-lint",
    "quality:fast": "pnpm quality:types-and-lint",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:one": "playwright test --workers=1"
  },
  "dependencies": {
    "@aps/contracts": "workspace:*",
    "@aps/mock-data": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.15.21",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-svelte": "^3.13.1",
    "svelte-eslint-parser": "^1.3.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.30.2",
    "svelte-check": "^4.2.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  }
}
